# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://referi:referi_dev_password@localhost:5433/referi"

# ──────────────────────────────────────────────
# Redis / BullMQ
# ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ──────────────────────────────────────────────
# Auth.js (NextAuth v5)
# ──────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# GitHub OAuth (create at github.com/settings/developers)
# ──────────────────────────────────────────────
GITHUB_ID=""
GITHUB_SECRET=""

# AES-256 key for encrypting GitHub access tokens (32 bytes as hex)
GITHUB_TOKEN_ENCRYPTION_KEY=""

# ──────────────────────────────────────────────
# ЮКасса (YooKassa)
# ──────────────────────────────────────────────
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Тестовый кошелёк для выплат (mock/localhost), пока в профиле не задан yookassaPayoutDestination
YOOKASSA_PAYOUT_MOCK_WALLET=""

# ──────────────────────────────────────────────
# Telegram Bot
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
# Bot username without @, e.g. "referi_bot"
TELEGRAM_BOT_USERNAME="referi_bot"
TELEGRAM_WEBHOOK_SECRET="change-me-min-32-chars"
TELEGRAM_MODERATOR_CHAT_ID=""

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NEXT_PUBLIC_URL="http://localhost:3000"
NODE_ENV="development"
# true в Docker/production для запуска BullMQ-воркеров вместе с next start (см. src/instrumentation.ts)
ENABLE_BULLMQ_WORKERS="false"

# ──────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────
FEATURE_REAL_PAYMENTS="false"
FEATURE_TELEGRAM="false"
FEATURE_EMAIL="false"
FEATURE_RATE_LIMITING="false"

# ──────────────────────────────────────────────
# SMTP (email notifications)
# ──────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@referi.ru"

# ──────────────────────────────────────────────
# Sentry (error monitoring)
# ──────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
