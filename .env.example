# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://referi:referi_dev_password@localhost:5432/referi"

# ──────────────────────────────────────────────
# Redis / BullMQ
# ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────
# Auth.js (NextAuth v5)
# ──────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# GitHub OAuth (create at github.com/settings/developers)
# ──────────────────────────────────────────────
GITHUB_ID=""
GITHUB_SECRET=""

# AES-256 key for encrypting GitHub access tokens (32 bytes as hex)
GITHUB_TOKEN_ENCRYPTION_KEY=""

# ──────────────────────────────────────────────
# ЮКасса (YooKassa)
# ──────────────────────────────────────────────
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# ──────────────────────────────────────────────
# Telegram Bot
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET="change-me-min-32-chars"
TELEGRAM_MODERATOR_CHAT_ID=""

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NEXT_PUBLIC_URL="http://localhost:3000"
NODE_ENV="development"

# ──────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────
FEATURE_REAL_PAYMENTS="false"
FEATURE_TELEGRAM="false"
FEATURE_EMAIL="false"
FEATURE_RATE_LIMITING="false"
