# Скопируйте в `.env`. Контракт валидируется в `src/env.ts` (Zod): при отсутствии
# или неверном значении обязательных переменных процесс падает при старте (fail-fast).
# Флаги `FEATURE_*` и `ENABLE_BULLMQ_WORKERS` — строго строки `true` или `false`.

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://referi:referi_dev_password@localhost:5433/referi"

# ──────────────────────────────────────────────
# Redis / BullMQ
# ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ──────────────────────────────────────────────
# Auth.js (NextAuth v5)
# ──────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# GitHub OAuth (create at github.com/settings/developers)
# ──────────────────────────────────────────────
GITHUB_ID="replace_with_github_oauth_app_client_id"
GITHUB_SECRET="replace_with_github_oauth_app_client_secret"

# AES-256 key for encrypting GitHub access tokens (минимум 32 символа; hex удобен)
GITHUB_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# ──────────────────────────────────────────────
# ЮКасса (YooKassa)
# ──────────────────────────────────────────────
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Кошелёк/идентификатор для мок-выплат, если у пользователя не задан yookassaPayoutDestination
YOOKASSA_PAYOUT_MOCK_WALLET="mock_payout_wallet_local"

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NEXT_PUBLIC_URL="http://localhost:3000"
# Публичная ссылка для связи с модерацией (например https://t.me/username). Можно оставить пустой строкой.
NEXT_PUBLIC_MODERATION_CONTACT_URL=""
NODE_ENV="development"
# BullMQ-воркеры: только `true` или `false`. Для `docker compose` сервиса `app` в compose задано `true`.
ENABLE_BULLMQ_WORKERS="false"

# ──────────────────────────────────────────────
# Feature Flags (строго `true` или `false`)
# ──────────────────────────────────────────────
FEATURE_REAL_PAYMENTS="false"
FEATURE_RATE_LIMITING="false"

# ──────────────────────────────────────────────
# Playwright (E2E): обязательна для `npm run test:e2e` (см. playwright.config.ts)
# ──────────────────────────────────────────────
PLAYWRIGHT_BASE_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# Sentry (error monitoring) — опционально; пустые строки = выключено
# ──────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
